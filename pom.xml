<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
         http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- ====================================================== -->
    <!-- MODELO MAVEN -->
    <!-- ====================================================== -->
    <modelVersion>4.0.0</modelVersion>
    <!-- ====================================================== -->
    <!-- SPRING BOOT -->
    <!-- ====================================================== -->
    <!--
        El parent de Spring Boot administra automáticamente
        las versiones compatibles de muchas dependencias.

        Gracias a esto no necesitamos colocar versión manual
        en starters como:
        - spring-boot-starter-web
        - spring-boot-starter-security
        - spring-boot-starter-data-jpa
        - spring-boot-starter-actuator
        - spring-boot-starter-test
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.13</version>
        <relativePath/>
    </parent>
    <!-- ====================================================== -->
    <!-- INFORMACIÓN DEL PROYECTO -->
    <!-- ====================================================== -->
    <groupId>com.facturacion</groupId>
    <artifactId>facturacion-service</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>facturacion-service</name>
    <description>
        Backend SaaS de Facturación Electrónica SUNAT
    </description>
    <!-- ====================================================== -->
    <!-- CONFIGURACIÓN GENERAL -->
    <!-- ====================================================== -->
    <properties>
        <!--
            El proyecto utiliza Java 21.
        -->
        <java.version>21</java.version>
        <!--
            Codificación utilizada por Maven.
        -->
        <project.build.sourceEncoding>
            UTF-8
        </project.build.sourceEncoding>
    </properties>
    <!-- ====================================================== -->
    <!-- DEPENDENCIAS -->
    <!-- ====================================================== -->

    <dependencies>
        <!-- ================================================== -->
        <!-- WEB / REST -->
        <!-- ================================================== -->
        <!--
            Permite crear:
            - Controllers REST
            - endpoints HTTP
            - JSON
            - servidor Tomcat embebido
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>


        <!-- ================================================== -->
        <!-- ACTUATOR / HEALTH CHECKS -->
        <!-- ================================================== -->
        <!--
            NECESARIA para:
            Health
            HealthIndicator
            y clases como:
            CertificateHealthIndicator.java
            También permite crear endpoints de monitoreo,
            por ejemplo:

            /actuator/health
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- ================================================== -->
        <!-- VALIDACIONES -->
        <!-- ================================================== -->
        <!--
            Permite utilizar anotaciones como:

            @NotNull
            @NotBlank
            @Size
            @Email
            @Valid
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- ================================================== -->
        <!-- JPA / HIBERNATE -->
        <!-- ================================================== -->
        <!--
            Permite trabajar con:

            @Entity
            JpaRepository
            Hibernate
            transacciones
            persistencia
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- ================================================== -->
        <!-- MYSQL -->
        <!-- ================================================== -->
        <!--
            Driver JDBC para conectarse a MySQL.

            runtime significa que no necesitamos utilizar
            directamente las clases del driver durante
            la compilación.
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- ================================================== -->
        <!-- LOMBOK -->
        <!-- ================================================== -->
        <!--
            Permite utilizar:
            @Getter
            @Setter
            @Builder
            @RequiredArgsConstructor
            @Slf4j
            etc.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- ================================================== -->
        <!-- FIRMA DIGITAL XML -->
        <!-- ================================================== -->
        <!--
            Apache Santuario.

            Utilizado para operaciones de seguridad XML
            y firma digital de los comprobantes UBL.
        -->
        <dependency>
            <groupId>org.apache.santuario</groupId>
            <artifactId>xmlsec</artifactId>
            <version>3.0.6</version>
        </dependency>
        <!-- ================================================== -->
        <!-- SPRING SECURITY -->
        <!-- ================================================== -->
        <!--
            Seguridad del backend:

            - autenticación
            - autorización
            - filtros
            - SecurityFilterChain
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- ================================================== -->
        <!-- JWT / JOSE -->
        <!-- ================================================== -->
        <!--
            Utilizado para trabajar con:

            JWT
            JWS
            JOSE
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>
        <!-- ================================================== -->
        <!-- QR -->
        <!-- ================================================== -->
        <!--
            ZXing se utiliza para generar el código QR
            requerido en la representación impresa
            del comprobante.
        -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.4</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>3.5.4</version>
        </dependency>
        <!-- ================================================== -->
        <!-- PDF -->
        <!-- ================================================== -->
        <!--
            Apache PDFBox se utiliza para generar
            la representación PDF del comprobante.
        -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.8</version>
        </dependency>
        <!-- ================================================== -->
        <!-- FLYWAY -->
        <!-- ================================================== -->
        <!--
            Flyway administra las migraciones
            de la base de datos.
            Ejemplo:
            V1__crear_tablas.sql
            V2__agregar_columna.sql
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!--
            Soporte específico de Flyway para MySQL.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <!-- ================================================== -->
        <!-- TEST -->
        <!-- ================================================== -->
        <!--
            Dependencia principal de pruebas.
            Incluye normalmente:

            - JUnit Jupiter / JUnit 5
            - Mockito
            - Mockito JUnit Jupiter
            - Spring Test
            - AssertJ
            etc.
            IMPORTANTE:
            scope test significa que estas librerías
            solamente existen dentro de:
            src/test/java
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ================================================== -->
        <!-- SPRING SECURITY TEST -->
        <!-- ================================================== -->
        <!--
            Herramientas específicas para probar
            endpoints protegidos por Spring Security.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            NO agregamos:
            junit:junit
            porque ese corresponde principalmente a JUnit 4.
            El proyecto utiliza JUnit 5 mediante:
            org.junit.jupiter.api.Test
            que ya viene incluido con:
            spring-boot-starter-test
        -->
    </dependencies>
    <!-- ====================================================== -->
    <!-- BUILD -->
    <!-- ====================================================== -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/*Testt.java</include>
                    </includes>
                </configuration>
            </plugin>
            <!-- ================================================== -->
            <!-- SPRING BOOT MAVEN PLUGIN -->
            <!-- ================================================== -->
            <!--
                Permite construir el JAR ejecutable de
                Spring Boot.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!--
                        Lombok solamente se necesita durante
                        compilación.
                        No necesitamos incluirlo dentro del
                        JAR final de producción.
                    -->
                    <excludes>
                        <exclude>
                            <groupId>
                                org.projectlombok
                            </groupId>
                            <artifactId>
                                lombok
                            </artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
